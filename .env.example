# V1.4 ships a technical traveler GLB and loads it by default.
# A blank VITE_TRAVELER_GLB_URL deliberately switches back to the old procedural traveler.
# Model artwork is NOT final: this demo proves actual skinned GLB and animations.
# Copy this file to .env.local only if you want to override defaults.
# Only same-origin URLs served from public/ are supported.
#
# When public/models/traveler.glb contains Idle/Walk/Bow/PlaceIncense
# animation clips and an IncenseGrip node, uncomment:
# VITE_TRAVELER_GLB_URL=/models/traveler.glb
#
# The deity GLB is static, 2.85m high, facing toward the forecourt (+Z).
# VITE_DEITY_GLB_URL=/models/wenchang.glb

# To disable the shipped GLB for regression comparison:
# VITE_TRAVELER_GLB_URL=
#
# To replace the demo with a final artist-authored rig:
# VITE_TRAVELER_GLB_URL=/models/traveler.glb

# V1.5 ships a static Wenchang deity GLB by default, facing the courtyard (+Z).
# If you want to compare with the old procedural statue:
# VITE_DEITY_GLB_URL=
# To override with an artist-authored statue respecting the asset contract:
# VITE_DEITY_GLB_URL=/models/wenchang.glb
