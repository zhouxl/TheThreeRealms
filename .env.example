# Copy this file to .env.local. Empty values keep the current procedural scene.
# Only same-origin URLs served from public/ are supported.
#
# When public/models/traveler.glb contains Idle/Walk/Bow/PlaceIncense
# animation clips and an IncenseGrip node, uncomment:
# VITE_TRAVELER_GLB_URL=/models/traveler.glb
#
# The deity GLB is static, 2.85m high, facing toward the forecourt (+Z).
# VITE_DEITY_GLB_URL=/models/wenchang.glb
